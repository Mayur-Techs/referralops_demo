# Matrix360 Lead Platform Configuration
# NEVER commit real API keys or passwords.

# --- Database Selection ---
# Local SQLite demo / single-machine dev:
DATABASE_URL=sqlite:///./referralops.db

# Hosted multi-user shared deployment (PostgreSQL):
# DATABASE_URL=postgresql://postgres_user:secure_password@db.example.host:5432/matrix360_leads?sslmode=require

# --- Admin API Security ---
# Protects GET /api/v1/leads, lead passport, approvals, and KPIs.
# Change to a strong random secret before shared deployment.
ADMIN_API_KEY=demo-admin-key

# --- Shared AI Connection (Server-side only) ---
# Supported providers: demo | xai | openai
AI_PROVIDER=demo

# xAI / Grok configuration (Primary team AI connection)
XAI_API_KEY=
XAI_MODEL=grok-beta
XAI_TIMEOUT_SECONDS=15

# OpenAI configuration (Future provider fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15

# --- Compliance & Consent ---
CONSENT_NOTICE_VERSION=matrix360-v1
